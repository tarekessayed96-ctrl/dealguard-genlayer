from genlayer import *
import json


class DealGuardV9(gl.Contract):

    verifications: TreeMap[str, str]
    verification_count: u32

    def __init__(self):
        self.verification_count = 0

    @gl.public.write
    def analyze_deal(
        self,
        case_id: str,
        title: str,
        description: str,
        deal_url: str,
        second_source_url: str
    ) -> str:

        # ---------- 1. Validation ----------
        if not case_id:
            raise Exception("case_id cannot be empty")
        if not title:
            raise Exception("title cannot be empty")
        if not description:
            raise Exception("description cannot be empty")
        if not deal_url.startswith("https://"):
            raise Exception("deal_url must start with https://")
        if not second_source_url.startswith("https://"):
            raise Exception("second_source_url must start with https://")

        # ---------- 2. Fast fallback ----------
        def fallback(reason: str) -> str:
            return json.dumps({
                "case_id": case_id,
                "verdict": "RISKY",
                "risk_score": 75,
                "confidence": 80,
                "summary": "Could not complete reliable verification.",
                "reasons": [reason, "Insufficient evidence for SAFE verdict."],
                "evidence": []
            }, sort_keys=True)

        # ---------- 3. Analysis ----------
        def analyze() -> str:

            # --- Fetch primary (limited size for speed) ---
            try:
                page = gl.nondet.web.get(deal_url)
                primary = page.body.decode("utf-8")[:4000] or "Empty content"
            except Exception as e:
                primary = f"PRIMARY_ERROR: {str(e)[:200]}"

            # --- Fetch secondary ---
            try:
                page = gl.nondet.web.get(second_source_url)
                secondary = page.body.decode("utf-8")[:4000] or "Empty content"
            except Exception as e:
                secondary = f"SECONDARY_ERROR: {str(e)[:200]}"

            # --- Compact prompt (much faster) ---
            prompt = f"""You are DealGuard. Analyze this deal for fraud risk using ONLY the two sources below.

CASE: {case_id}
TITLE: {title}
DESCRIPTION: {description}
URL1: {deal_url}
URL2: {second_source_url}

SOURCE 1:
{primary}

SOURCE 2:
{secondary}

Rules:
- Use only the content above. Never invent facts.
- If URLs are identical → not independent sources.
- Missing info increases risk.
- If sources failed to load → treat as high uncertainty.

Return ONLY this JSON:
{{
  "case_id": "{case_id}",
  "verdict": "SAFE|RISKY|HIGH_RISK",
  "risk_score": 0-100,
  "confidence": 0-100,
  "summary": "one short sentence",
  "reasons": ["reason1", "reason2"],
  "evidence": ["fact from sources"]
}}
"""

            try:
                result = gl.nondet.exec_prompt(prompt, response_format="json")
            except Exception as e:
                return fallback("AI analysis failed: " + str(e)[:150])

            if not result:
                return fallback("Empty AI response")

            if not isinstance(result, str):
                try:
                    result = json.dumps(result, sort_keys=True)
                except Exception:
                    return fallback("Unsupported AI result type")

            try:
                parsed = json.loads(result)
            except Exception:
                return fallback("Invalid JSON from AI")

            if not isinstance(parsed, dict):
                return fallback("Invalid structure from AI")

            # Force correct case_id
            parsed["case_id"] = case_id

            # Normalize verdict
            if parsed.get("verdict") not in ("SAFE", "RISKY", "HIGH_RISK"):
                parsed["verdict"] = "RISKY"

            # Normalize scores
            try:
                parsed["risk_score"] = max(0, min(100, int(parsed.get("risk_score", 75))))
            except Exception:
                parsed["risk_score"] = 75

            try:
                parsed["confidence"] = max(0, min(100, int(parsed.get("confidence", 50))))
            except Exception:
                parsed["confidence"] = 50

            if not isinstance(parsed.get("summary"), str):
                parsed["summary"] = "Verification completed with limited evidence."

            if not isinstance(parsed.get("reasons"), list):
                parsed["reasons"] = []

            if not isinstance(parsed.get("evidence"), list):
                parsed["evidence"] = []

            return json.dumps(parsed, sort_keys=True)

        # ---------- 4. Consensus (lighter criteria) ----------
        criteria = """
Valid JSON only.
Must contain: case_id, verdict, risk_score, confidence, summary, reasons, evidence.
verdict = SAFE | RISKY | HIGH_RISK
risk_score & confidence = integers 0-100
Use only provided source content. Do not invent facts.
"""

        try:
            result = gl.eq_principle.prompt_non_comparative(
                analyze,
                task="Verify online deal risk using two web sources.",
                criteria=criteria
            )
        except Exception as e:
            result = fallback("Consensus failed: " + str(e)[:150])

        # ---------- 5. Final sanitize + store ----------
        try:
            parsed = json.loads(result)
            if not isinstance(parsed, dict):
                raise Exception("bad structure")
        except Exception:
            parsed = json.loads(fallback("Final result invalid"))

        parsed["case_id"] = case_id

        if parsed.get("verdict") not in ("SAFE", "RISKY", "HIGH_RISK"):
            parsed["verdict"] = "RISKY"

        try:
            parsed["risk_score"] = max(0, min(100, int(parsed.get("risk_score", 75))))
        except Exception:
            parsed["risk_score"] = 75

        try:
            parsed["confidence"] = max(0, min(100, int(parsed.get("confidence", 50))))
        except Exception:
            parsed["confidence"] = 50

        if not isinstance(parsed.get("summary"), str):
            parsed["summary"] = "Verification completed."
        if not isinstance(parsed.get("reasons"), list):
            parsed["reasons"] = []
        if not isinstance(parsed.get("evidence"), list):
            parsed["evidence"] = []

        final_result = json.dumps(parsed, sort_keys=True)

        self.verifications[case_id] = final_result
        self.verification_count += 1

        return final_result

    @gl.public.view
    def get_verification(self, case_id: str) -> str:
        result = self.verifications.get(case_id, "")
        if result == "":
            return json.dumps({
                "case_id": case_id,
                "verdict": "UNKNOWN",
                "risk_score": 0,
                "confidence": 0,
                "summary": "Verification not found.",
                "reasons": [],
                "evidence": []
            })
        return result

    @gl.public.view
    def get_verification_count(self) -> u32:
        return self.verification_count
